# ============================================================
# CogniCore™ – .gitignore
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules
.pnp
.pnp.js
.yarn/install-state.gz

# ── Build Outputs ─────────────────────────────────────────────
dist
build
out
*.tsbuildinfo

# ── Next.js ───────────────────────────────────────────────────
.next
next-env.d.ts

# ── Turbo ────────────────────────────────────────────────────
.turbo

# ── Test / Coverage ───────────────────────────────────────────
coverage
*.lcov
.nyc_output

# ── Environment Variables ─────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep .env.example tracked
!.env.example

# ── Logs ─────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS / Editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# ── Docker ───────────────────────────────────────────────────
.docker-data

# ── Misc ─────────────────────────────────────────────────────
*.pem
*.key
*.cert
.cache
tmp
temp
