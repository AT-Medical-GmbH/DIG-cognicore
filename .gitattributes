# ============================================================
# AT Medical – .gitattributes
# CogniCore™ | DIG-cognicore
# ============================================================

# ── Auto-detect text files and normalise line endings ────────
* text=auto eol=lf

# ── TypeScript / JavaScript ───────────────────────────────────
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf

# ── Python (AI/ML scripts and tooling) ───────────────────────
*.py          text eol=lf
*.pyi         text eol=lf
*.pyw         text eol=lf
requirements*.txt text eol=lf
pyproject.toml    text eol=lf
setup.cfg         text eol=lf

# ── Markup / Config ───────────────────────────────────────────
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.md   text eol=lf
*.mdx  text eol=lf
*.txt  text eol=lf

# ── Shell / Scripts ───────────────────────────────────────────
*.sh   text eol=lf
*.bash text eol=lf

# ── Docker ───────────────────────────────────────────────────
Dockerfile     text eol=lf
*.dockerfile   text eol=lf
docker-compose*.yml text eol=lf

# ── SQL ──────────────────────────────────────────────────────
*.sql  text eol=lf

# ── Binary files (do not modify) ─────────────────────────────
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.tgz   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.eot   binary
*.mp4   binary
*.webm  binary
*.mp3   binary
*.wav   binary

# ── Diff driver hints ─────────────────────────────────────────
*.ts   diff=typescript
*.tsx  diff=typescript
*.js   diff=javascript
*.jsx  diff=javascript
*.py   diff=python
*.json diff=json
*.md   diff=markdown
