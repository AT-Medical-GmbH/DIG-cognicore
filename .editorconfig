# ============================================================
# AT Medical – .editorconfig
# CogniCore™ | DIG-cognicore
# https://editorconfig.org
# ============================================================

root = true

# ── Defaults (all files) ─────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ── TypeScript / JavaScript ───────────────────────────────────
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_style = space
indent_size = 2

# ── JSON ─────────────────────────────────────────────────────
[*.json]
indent_style = space
indent_size = 2

# ── YAML / TOML ───────────────────────────────────────────────
[*.{yml,yaml,toml}]
indent_style = space
indent_size = 2

# ── CSS / SCSS ───────────────────────────────────────────────
[*.{css,scss,less}]
indent_style = space
indent_size = 2

# ── HTML ─────────────────────────────────────────────────────
[*.html]
indent_style = space
indent_size = 2

# ── Python (AI/ML scripts and tooling) ───────────────────────
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

# ── Markdown ─────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
max_line_length = 80

# ── Makefiles ────────────────────────────────────────────────
[Makefile]
indent_style = tab

# ── Shell scripts ────────────────────────────────────────────
[*.sh]
indent_style = space
indent_size = 2
