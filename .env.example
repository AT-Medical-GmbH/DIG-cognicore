# ==========================================
# CogniCore™ Environment Configuration
# A product by AT Medical GmbH®
# ==========================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://cognicore:password@localhost:5432/cognicore_dev

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── API Core ──────────────────────────────────────────────────
API_CORE_URL=http://localhost:4000
API_CORE_PORT=4000

# ── Realtime Gateway ──────────────────────────────────────────
REALTIME_GATEWAY_PORT=4001
REALTIME_GATEWAY_URL=ws://localhost:4001

# ── Speech / Caption Providers (leave empty to disable) ───────
OPENAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
DEEPGRAM_API_KEY=
WHISPER_MODEL=

# ── Translation Providers ─────────────────────────────────────
DEEPL_API_KEY=
GOOGLE_TRANSLATE_KEY=

# ── Recording ─────────────────────────────────────────────────
RECORDING_STORAGE_PATH=./storage/recordings
RECORDING_MAX_DURATION_MINUTES=180

# ── Session ───────────────────────────────────────────────────
SESSION_ID_LENGTH=6
SESSION_DEFAULT_TIMEOUT_MINUTES=480

# ── CogniCoach ────────────────────────────────────────────────
COGNICOACH_DEFAULT_RESET_INTERVAL_MINUTES=30

# ── Feature Flags ─────────────────────────────────────────────
FEATURE_RECORDING=false
FEATURE_LIVE_CAPTIONS=false
FEATURE_TRANSLATION=false
FEATURE_POLLING=true
FEATURE_REMOTE=true
FEATURE_ANALYTICS=false

# ── Licensing ─────────────────────────────────────────────────
LICENSE_UNLOCK_SECRET=
LICENSE_API_URL=

# ── LTI ───────────────────────────────────────────────────────
LTI_CLIENT_ID=
LTI_PLATFORM_URL=
LTI_DEPLOYMENT_ID=

# ── Moodle ────────────────────────────────────────────────────
MOODLE_URL=
MOODLE_TOKEN=

# ── Storage ───────────────────────────────────────────────────
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
