# Hoist all dependencies to root node_modules for broader tool compatibility
# (e.g., IDE plugins, global ESLint, Prettier runners)
shamefully-hoist=true

# Strict peer dependency checking – surfaces incompatibility issues early
strict-peer-dependencies=false

# Automatically install missing peer dependencies
auto-install-peers=true

# Deduplicate packages on install
dedupe-peer-dependents=true

# Use the lockfile to ensure reproducible installs
prefer-frozen-lockfile=false

# Store path (optional, uncomment to customise)
# store-dir=~/.pnpm-store
