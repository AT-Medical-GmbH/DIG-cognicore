{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["**/*.{ts,tsx,js,jsx}", ".eslintrc*", "eslint.config.*"]
    },
    "lint:fix": {
      "inputs": ["**/*.{ts,tsx,js,jsx}", ".eslintrc*", "eslint.config.*"],
      "cache": false
    },
    "test": {
      "inputs": ["**/*.{ts,tsx,js,jsx}", "**/*.spec.*", "**/*.test.*"],
      "outputs": ["coverage/**"]
    },
    "test:ci": {
      "inputs": ["**/*.{ts,tsx,js,jsx}", "**/*.spec.*", "**/*.test.*"],
      "outputs": ["coverage/**"]
    },
    "type-check": {
      "inputs": ["**/*.{ts,tsx}", "tsconfig*.json"]
    },
    "clean": {
      "cache": false
    },
    "format": {
      "cache": false
    }
  }
}
